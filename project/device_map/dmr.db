    <general_container id="device_map_timing_constraint">
        <table_container>
            <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_clock -period {37.037} [get_ports {clk}] -name clk</data>
                </row>
                <row>
                    <data>create_clock -period {100.000} [get_ports {JTAG_TCK}] -name JTAG_CLK</data>
                </row>
                <row>
                    <data>create_clock -period {10.000} [get_ports {cam1_pclk}] -name CAM1_PCLK</data>
                </row>
                <row>
                    <data>create_clock -period {10.000} [get_ports {cam2_pclk}] -name CAM2_PCLK</data>
                </row>
                <row>
                    <data>create_generated_clock -name cpu_clk -source [get_ports {clk}] -master_clock clk -multiply_by 70 -divide_by 27 [get_pins {g_ddr_profile.u_pll/u_gpll:CLKOUT0}]</data>
                </row>
                <row>
                    <data>set_clock_groups -asynchronous -group [get_clocks {ddr_ref_clk ddr_core_clk}] -group [get_clocks {ddr_rst_clk}] -group [get_clocks {clk cpu_clk}] -group [get_clocks {JTAG_CLK}] -group [get_clocks {CAM1_PCLK}] -group [get_clocks {CAM2_PCLK}]</data>
                </row>
                <row>
                    <data>define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}</data>
                </row>
            </table>
        </table_container>
        <table_container>
            <table id="device_map_timing_constraint" title="Inferred clocks commands" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_generated_clock -name {ddr_ref_clk|g_ddr_profile.u_ddr3_ctrl/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[0].ddrphy_ppll/u_ppll/CLKOUTPHY_Inferred} -master_clock {ddr_ref_clk} -source [get_ports {clk_p}] -edges {1 2 3} -edge_shift {0.000000 -3.500000 -7.000000} [get_pins {g_ddr_profile.u_ddr3_ctrl/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[0].ddrphy_ppll/u_ppll.CLKOUTPHY}] -add</data>
                </row>
