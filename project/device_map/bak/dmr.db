    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -period {37.037} [get_ports {clk}] -name clk</data>
        </row>
        <row>
            <data>create_clock -period {100.000} [get_ports {JTAG_TCK}] -name JTAG_CLK</data>
        </row>
        <row>
            <data>create_clock -period {10.000} [get_ports {cam1_pclk}] -name CAM1_PCLK</data>
        </row>
        <row>
            <data>create_clock -period {10.000} [get_ports {cam2_pclk}] -name CAM2_PCLK</data>
        </row>
        <row>
            <data>create_generated_clock -name cpu_clk -source [get_ports {clk}] -master_clock clk -multiply_by 70 -divide_by 27 [get_pins {g_ddr_profile.u_pll/u_gpll:CLKOUT0}]</data>
        </row>
        <row>
            <data>create_generated_clock -name phy_dq_clk_1 -source [get_ports {clk_p}] -master_clock ddr_ref_clk -edges {1 2 3} -edge_shift {0.000 -3.500 -7.000} [get_pins {g_ddr_profile.u_ddr3_ctrl/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[1].ddrphy_ppll/u_ppll:CLKOUTPHY}]</data>
        </row>
        <row>
            <data>create_generated_clock -name phy_dq_sysclk_1 -source [get_pins {g_ddr_profile.u_ddr3_ctrl/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[1].ddrphy_ppll/u_ppll:CLKOUTPHY}] -master_clock phy_dq_clk_1 -edges {1 2 3} -edge_shift {2.000 5.500 9.000} [get_pins {g_ddr_profile.u_ddr3_ctrl/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[1].u_ddrphy_ioclkdiv:CLKDIVOUT}]</data>
        </row>
        <row>
            <data>define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}</data>
        </row>
        <row>
            <data>define_attribute {p:hard_rst_n} {PAP_IO_STANDARD} {LVCMOS33}</data>
        </row>
        <row>
            <data>define_attribute {p:cam1_scl} {PAP_IO_LOC} {W21}</data>
        </row>
        <row>
            <data>define_attribute {p:cam1_sda} {PAP_IO_LOC} {U14}</data>
        </row>
        <row>
            <data>define_attribute {p:cam1_reset_n} {PAP_IO_STANDARD} {LVCMOS33}</data>
        </row>
        <row>
            <data>define_attribute {p:cam1_reset_n} {PAP_IO_LOC} {T20}</data>
        </row>
        <row>
            <data>define_attribute {p:cam1_reset_n} {PAP_IO_VCCIO} {3.3}</data>
        </row>
    </table>
    <table id="device_map_clock_signal" title="Clock Signal" column_number="5">
        <column_headers>
            <data>Driver_Pin_Name</data>
            <data>Clk_Source_Inst</data>
            <data>Clk_Inst_Name</data>
            <data>Net_Name</data>
