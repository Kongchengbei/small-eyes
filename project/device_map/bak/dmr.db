    <general_container id="device_map_timing_constraint">
        <table_container>
            <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_clock -period {37.037} [get_ports {clk}] -name clk</data>
                </row>
                <row>
                    <data>create_clock -period {100.000} [get_ports {JTAG_TCK}] -name JTAG_CLK</data>
                </row>
                <row>
                    <data>create_clock -period {10.000} [get_ports {cam1_pclk}] -name CAM1_PCLK</data>
                </row>
                <row>
                    <data>create_generated_clock -name cpu_clk -source [get_ports {clk}] -master_clock clk -multiply_by 70 -divide_by 27 [get_pins {u_pll/u_gpll:CLKOUT0}]</data>
                </row>
                <row>
                    <data>define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}</data>
                </row>
            </table>
        </table_container>
