test/
camera_demo/
# Ignore the BSP tree by default.
/bsp/*

# Keep the bsp_app directory reachable, then ignore its contents.
!/bsp/bsp_app/
/bsp/bsp_app/*

# Track only the linker script from bsp_app.
!/bsp/bsp_app/link.lds

# Track the standalone camera bring-up firmware and its ready-to-flash image.
!/bsp/camera_app/
/bsp/camera_app/*
!/bsp/camera_app/Makefile
!/bsp/camera_app/README.md
!/bsp/camera_app/link.lds
!/bsp/camera_app/main.c
!/bsp/camera_app/uart.c
!/bsp/camera_app/uart.h
!/bsp/camera_app/camera_sccb.c
!/bsp/camera_app/camera_sccb.h
!/bsp/camera_app/camera_dvp.c
!/bsp/camera_app/camera_dvp.h
!/bsp/camera_app/ov5640.c
!/bsp/camera_app/ov5640.h
!/bsp/camera_app/ov5640_regs.c
!/bsp/camera_app/ov5640_regs.h
!/bsp/camera_app/camera_uart_debug.bin
!/bsp/camera_app/camera_uart_debug_local.bin
!/bsp/camera_app/camera_uart_debug_remote.bin
!/bsp/camera_app/gpio_test.c
!/bsp/camera_app/camera_gpio_test_local.bin
!/bsp/camera_app/camera_gpio_test_remote.bin

# Ignore generated build output.
!/bsp/camera_stereo_app/
/bsp/camera_stereo_app/*
!/bsp/camera_stereo_app/*.c
!/bsp/camera_stereo_app/*.h
!/bsp/camera_stereo_app/Makefile
!/bsp/camera_stereo_app/README.md
!/bsp/camera_stereo_app/link.lds
!/bsp/camera_stereo_app/camera_stereo*.bin
!/bsp/camera_stereo_app/camera_cam2_only*.bin
/build/
