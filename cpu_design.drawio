                <mxCell id="h2_title" value="② Load 后立即使用：暂停（Stall / 气泡）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#17212b;" parent="h1" vertex="1">
                    <mxGeometry x="60" y="560" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="h2_cap" value="Load 的数据要到 MEM 阶段结束才可用；紧挨着的使用指令在 ID 停一个周期（出现一个气泡），随后继续" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52606d;" parent="h1" vertex="1">
                    <mxGeometry x="60" y="592" width="1400" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="h2_grid" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:14px;border-color:#2f3439&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-weight:bold;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;指令&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;lw  r2, 0(r1)&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;and r5, r2, r2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdeaea;font-weight:bold&quot;&gt;暂停&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;or  r8, r5, r5&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#fdeaea;font-weight:bold&quot;&gt;暂停&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;" parent="h1" vertex="1">
                    <mxGeometry x="150" y="620" width="620" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="h3_title" value="③ 分支 / 跳转 / 异常：清空（Flush / 重定向）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#17212b;" parent="h1" vertex="1">
                    <mxGeometry x="60" y="890" width="1000" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="h3_cap" value="分支在 ID 阶段判定；其后已取入的指令来自错误路径，被清空丢弃，随后从目标地址重新取指" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52606d;" parent="h1" vertex="1">
                    <mxGeometry x="60" y="922" width="1400" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="h3_grid" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:14px;border-color:#2f3439&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-weight:bold;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;指令&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;beq r1, r2, 目标&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;（错误路径）i+1&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#fdeaea;font-weight:bold&quot;&gt;清空&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;（错误路径）i+2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#fdeaea;font-weight:bold&quot;&gt;清空&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;目标指令&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;" parent="h1" vertex="1">
                    <mxGeometry x="150" y="950" width="620" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="h3_note" value="红色格为被清空的错误路径指令（已在流水线中但作废）。异常 / ecall / mret 在 EX 阶段触发，同样清空并按 mtvec / mepc 重定向。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f7f8;strokeColor=#d5dbe0;strokeWidth=1;fontSize=13;fontColor=#52606d;align=left;verticalAlign=middle;spacingLeft=12;" parent="h1" vertex="1">
                    <mxGeometry x="150" y="1180" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="h4_title" value="④ 多周期运算 / 访存未就绪：暂停（EX 阶段等待）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#17212b;" parent="h1" vertex="1">
                    <mxGeometry x="60" y="1260" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="h4_cap" value="除法器需要多个周期才完成；数据存储器未就绪（握手）时也不能写回 → EX 阶段暂停，等待完成或就绪后再前进" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52606d;" parent="h1" vertex="1">
                    <mxGeometry x="60" y="1292" width="1400" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="h4_note" value="处理策略总结：能旁路就旁路；数据没准备好就暂停；执行路径改变就清空并重新取指。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=#d5dbe0;strokeWidth=1;fontSize=15;fontColor=#27313a;align=center;verticalAlign=middle;" parent="h1" vertex="1">
                    <mxGeometry x="300" y="1360" width="1000" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
