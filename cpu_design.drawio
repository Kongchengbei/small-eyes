                </mxCell>
                <mxCell id="p_grid" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:14px;border-color:#2f3439&quot;&gt;&lt;tr&gt;&lt;td style=&quot;font-weight:bold;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;指令&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;background-color:#eef1f4&quot; align=&quot;center&quot;&gt;9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;lw  r2, 0(r1)&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;add r5, r2, r3&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;sub r6, r4, r2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;and r7, r2, r1&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;or  r8, r2, r6&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&quot;background-color:#eef4fb;font-weight:bold&quot;&gt;IF&lt;/td&gt;&lt;td style=&quot;background-color:#eef7f0;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;background-color:#fdf6ea;font-weight:bold&quot;&gt;EX&lt;/td&gt;&lt;td style=&quot;background-color:#fdeeee;font-weight:bold&quot;&gt;MEM&lt;/td&gt;&lt;td style=&quot;background-color:#f6f1f9;font-weight:bold&quot;&gt;WB&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;" parent="p1" vertex="1">
