            <value>36K</value>
        </param>
        <param>
            <name>A_FAB_REG</name>
            <value>false</value>
        </param>
        <param>
            <name>B_RD_OCE_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>A_RD_OCE_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>B_CLK_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>CAS_MODE_SEL</name>
            <value>AUTO</value>
        </param>
        <param>
            <name>A_CLK_OR_POL_INV</name>
            <value>false</value>
        </param>
        <param>
            <name>POWER_OPT</name>
            <value>false</value>
        </param>
        <param>
            <name>B_OUTPUT_REG</name>
            <value>false</value>
        </param>
        <param>
            <name>B_WRITE_MODE</name>
            <value>NORMAL_WRITE</value>
        </param>
        <param>
            <name>SAMEWIDTH_EN</name>
            <value>true</value>
        </param>
        <param>
            <name>INIT_FORMAT</name>
            <value>HEX</value>
        </param>
        <param>
            <name>B_FAB_REG</name>
            <value>false</value>
        </param>
        <param>
            <name>INIT_FILE</name>
            <value>F:/Jichuang-small_eyes/small-eyes/small-eyes1/source/jtag_soc/coremark.dat</value>
        </param>
