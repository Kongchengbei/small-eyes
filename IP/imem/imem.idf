            <value>32</value>
        </param>
        <param>
            <name>A_ADDR_STROBE_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>A_DATA_WIDTH</name>
            <value>32</value>
        </param>
        <param>
            <name>RST_VAL_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>A_OUTPUT_REG</name>
            <value>false</value>
        </param>
        <param>
            <name>A_CLK_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>B_BE_WIDTH</name>
            <value>4</value>
        </param>
        <param>
            <name>RESET_TYPE</name>
            <value>SYNC</value>
        </param>
        <param>
            <name>A_BE_WIDTH</name>
            <value>4</value>
        </param>
        <param>
            <name>B_ADDR_STROBE_EN</name>
            <value>false</value>
        </param>
        <param>
            <name>BYTE_SIZE</name>
            <value>8</value>
        </param>
        <param>
            <name>INIT_EN</name>
            <value>true</value>
        </param>
        <param>
