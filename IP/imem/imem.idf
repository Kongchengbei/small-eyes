        </pin>
        <pin>
            <name>a_wr_byte_en</name>
            <text>a_wr_byte_en</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>3</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_clk</name>
            <text>a_clk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>a_rst</name>
            <text>a_rst</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>b_addr</name>
            <text>b_addr</text>
            <dir>input</dir>
            <pos>right</pos>
            <msb>12</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_wr_data</name>
            <text>b_wr_data</text>
            <dir>input</dir>
            <pos>right</pos>
            <msb>31</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_rd_data</name>
            <text>b_rd_data</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>31</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_wr_en</name>
            <text>b_wr_en</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>b_wr_byte_en</name>
            <text>b_wr_byte_en</text>
            <dir>input</dir>
            <pos>right</pos>
            <msb>3</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b_clk</name>
            <text>b_clk</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>b_rst</name>
            <text>b_rst</text>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
    </pin_list>
    <synthesis>
        <script><![CDATA[set_option -vlog_std v2001]]></script>
        <script><![CDATA[set_option -disable_io_insertion 1]]></script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="imem_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="imem_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="imem_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipm2l_dpram_v1_9_imem.v"/>
            <file pathname="imem.v"/>
        </source>
    </file_list>
</ip_inst>
