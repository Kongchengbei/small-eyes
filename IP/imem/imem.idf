<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>04100201</id>
        <display_name>DRM Based Dual Port RAM</display_name>
        <name>28nm DRM Based Dual Port RAM</name>
        <version>1.9</version>
        <instance>imem</instance>
        <family>Logos2</family>
        <device>PG2L200H</device>
        <package>FBB676</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.4" build="146967">IP Compiler</generator>
    </header>
    <param_list>
