    <pin_list>
        <pin>
            <name>a_addr</name>
            <text>a_addr</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>12</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_wr_data</name>
            <text>a_wr_data</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>31</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_rd_data</name>
            <text>a_rd_data</text>
            <dir>output</dir>
            <pos>left</pos>
            <msb>31</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a_wr_en</name>
            <text>a_wr_en</text>
            <dir>input</dir>
