define_attribute {p:fpioa[1]} {PAP_IO_LOC} {B24}
define_attribute {p:fpioa[1]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:fpioa[1]} {PAP_IO_STANDARD} {LVCMOS33}

# fpioa[2:7]: 扩展口 12/14/18/20/22/24，板卡通用 IO（由 FPIOA 复用）
