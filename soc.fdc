define_attribute {p:cam1_scl} {PAP_IO_LOC} {W21}
define_attribute {p:cam1_scl} {PAP_IO_VCCIO} {3.3}
define_attribute {p:cam1_scl} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:cam1_scl} {PAP_IO_DRIVE} {4}

