#----------------------FPIOA---------------------------
# fpioa[31:0] 是 Hfpga_soc 的一个完整双向可复用 IO 总线，32 位均为真实顶层端口，
# 因此全部保留约束。UART/LED/按键/PWM/GPIO 等功能由运行时 FPIOA 复用寄存器选择，
# 下列注释中的扩展口编号只表示 PCB 连接关系，不代表固定的 RTL 外设接口。
#----------------------FPIOA[0:31]---------------------------
# 每个位都是板卡通用 IO，实际功能由 FPIOA 复用寄存器决定；这里仅记录 PCB 位置。
# fpioa[0]: C24，本地主板 CP2102 的 FPGA UART TX；由 FPIOA 复用选择。
define_attribute {p:fpioa[0]} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:fpioa[0]} {PAP_IO_LOC} {C24}
define_attribute {p:fpioa[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:fpioa[0]} {PAP_IO_STANDARD} {LVCMOS33}

# fpioa[1]: B24，本地主板 CP2102 的 FPGA UART RX；当前调试仅实现 TX。
