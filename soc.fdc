# 板型核对（2026-09-25）：以下 J10 扩展口(sd卡）映射来自 MINI-100HP(200H) 底板资料。
# 用户实物底板的 J10 是 SD 卡槽，不能把 R20/P19/M24/T24 当作可从 J10
# 接入的自定义 JTAG 引脚。请按实物板卡重新核对这些普通 IO 的用途。
# 实装 FPGA 已确认 PG2L200H；工程及 IP 均选 PG2L200H-FBB676。
#时序约束
create_clock -period {37.037} [get_ports {clk}] -name clk

# JTAG时钟约束 (10MHz, 100ns周期)
create_clock -period {100.000} [get_ports {JTAG_TCK}] -name JTAG_CLK

# CAM1 PCLK 由 OV5640 输出。这里按最高 100 MHz 约束输入路径，实际 VGA
# 配置频率更低；它与 CPU/JTAG 时钟没有相位关系。
create_clock -period {10.000} [get_ports {cam1_pclk}] -name CAM1_PCLK
create_clock -period {10.000} [get_ports {cam2_pclk}] -name CAM2_PCLK

define_attribute {n:JTAG_TCK_in} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}


# BEGIN SOC_CPU_CLOCK (managed by menuconfig; PLL is configured manually in PDS)
create_generated_clock -name cpu_clk \
    -source [get_ports {clk}] \
    -master_clock clk \
    -multiply_by 70 \
    -divide_by 27 \
    [get_pins {u_pll/u_gpll:CLKOUT0}]
# END SOC_CPU_CLOCK
# 异步时钟域声明
set_clock_groups -asynchronous -group [get_clocks {cpu_clk}] -group [get_clocks {JTAG_CLK}]
set_clock_groups -asynchronous -group [get_clocks {cpu_clk}] -group [get_clocks {CAM1_PCLK}] -group [get_clocks {CAM2_PCLK}]

# IO 引脚约束：这里只保留 Hfpga_soc 顶层实际存在的外部端口。
# DDR3 端口使用板卡原理图/引脚表中的专用资源位置，不能改用普通 IO。
#----------------------系统时钟---------------------------
define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {D18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}

#----------------------系统复位---------------------------
define_attribute {p:hard_rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:hard_rst_n} {PAP_IO_LOC} {C22}
define_attribute {p:hard_rst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hard_rst_n} {PAP_IO_STANDARD} {LVCMOS33}

