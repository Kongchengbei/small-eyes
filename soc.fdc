# DDR3 125 MHz differential reference clock (N3/N2).
define_attribute {p:clk_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_n} {PAP_IO_LOC} {N2}
define_attribute {p:clk_n} {PAP_IO_VCCIO} {1.5}
define_attribute {p:clk_n} {PAP_IO_STANDARD} {HSTL15D_I}
define_attribute {p:clk_n} {PAP_IO_NONE} {TRUE}
define_attribute {p:clk_p} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_p} {PAP_IO_LOC} {N3}
define_attribute {p:clk_p} {PAP_IO_VCCIO} {1.5}
define_attribute {p:clk_p} {PAP_IO_STANDARD} {HSTL15D_I}
define_attribute {p:clk_p} {PAP_IO_NONE} {TRUE}

# DDR3 IP timing and placement constraints.  Instance paths match the
# generated DDR3 Interface v1.16a instance u_ddr3_ctrl in Hfpga_jtag_soc.v.
create_clock -name {ddr_ref_clk} [get_ports {clk_p}] -period {8.0} -waveform {0 4.0}
create_generated_clock -name {ddr_rst_clk} -source [get_ports {clk_p}] [get_pins {u_ddr3_ctrl.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {clk_p}] [get_pins {u_ddr3_ctrl.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {clk_p}] [get_pins {u_ddr3_ctrl.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_ddr3_ctrl.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_ctrl.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {clk_p}] [get_pins {u_ddr3_ctrl.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_ddr3_ctrl.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3_ctrl.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_groups -asynchronous -group [get_clocks {cpu_clk}] -group [get_clocks {ddr_ref_clk ddr_rst_clk ddrphy_sysclk phy_dq_clk_0 phy_dq_sysclk_0 phy_dq_clk_1 phy_dq_sysclk_1}]
define_attribute {i:u_ddr3_ctrl.u_ddrphy_top.u_ddrphy_cpd} {PAP_LOC} {DDRPHY_CPD_729_772}
define_attribute {i:u_ddr3_ctrl.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[0]} {PAP_LOC} {CLMA_717_672:FF3}
define_attribute {i:u_ddr3_ctrl.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[1]} {PAP_LOC} {CLMA_717_978:FF3}
