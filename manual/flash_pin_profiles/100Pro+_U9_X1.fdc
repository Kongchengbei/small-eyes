# ALTERNATE PIN PROFILE: 100Pro+ board-table U9 group, SPI X1.
# Use only after matching the exact physical PCB / schematic. This independent
# six-port fragment REPLACES the default Flash block in soc.fdc; do not load both.
# Table evidence: U9 => F25 chip select, P18 idle second select,
# R14 MOSI, R15 MISO, P14 WP_N, N14 HOLD_N. H13 remains GTP_CFGCLK.
define_attribute {p:flash_cs_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:flash_cs_n} {PAP_IO_LOC} {F25}
define_attribute {p:flash_cs_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_cs_n} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:flash_cs2_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:flash_cs2_n} {PAP_IO_LOC} {P18}
define_attribute {p:flash_cs2_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_cs2_n} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:flash_mosi} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:flash_mosi} {PAP_IO_LOC} {R14}
define_attribute {p:flash_mosi} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_mosi} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:flash_miso} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:flash_miso} {PAP_IO_LOC} {R15}
define_attribute {p:flash_miso} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_miso} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:flash_wp_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:flash_wp_n} {PAP_IO_LOC} {P14}
define_attribute {p:flash_wp_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_wp_n} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:flash_hold_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:flash_hold_n} {PAP_IO_LOC} {N14}
define_attribute {p:flash_hold_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_hold_n} {PAP_IO_STANDARD} {LVCMOS33}
